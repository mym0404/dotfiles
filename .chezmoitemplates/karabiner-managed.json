{
  "global": {
    "show_in_menu_bar": false
  },
  "profile": {
    "complex_modifications": {
      "rules": [
        {
          "description": "Send F19 tap immediately on Caps Lock down",
          "manipulators": [
            {
              "from": {
                "key_code": "caps_lock",
                "modifiers": {
                  "optional": ["any"]
                }
              },
              "to": [
                {
                  "key_code": "f19",
                  "repeat": false
                }
              ],
              "type": "basic"
            }
          ]
        },
        {
