export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="lambda-gitster"
zstyle ':omz:update' mode auto

plugins=(
  git
  zsh-autosuggestions
  direnv
  fzf
)

export PROJECTS="$HOME/projects"
export CODEX_HOME="$HOME/.codex"
export EDITOR=nvim
export PAGER='bat --color=always'
export MANPAGER='bat --color=always'
export PATH="$HOME/.local/bin:$PATH"

export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$PATH:$ANDROID_HOME/emulator"
export PATH="$PATH:$ANDROID_HOME/platform-tools"

alias cat='bat'
alias g=git

source "$ZSH/oh-my-zsh.sh"

alias vim='nvim'
alias v='nvim'
alias VIM='cd ~/.config/nvim && vim .'
alias ws=webstorm

alias MISE='cd ~/.config/mise'
alias x='codex'

# Shortcuts
alias D='cd ~/Desktop'
alias PRO='cd "$PROJECTS"'
alias DOWN='cd ~/Downloads'
alias APP='cd /Applications'
alias WEZ='vim ~/.wezterm.lua'
alias CODEX='cd ~/.codex'
alias ZED='cd ~/.config/zed'
alias P='vim ~/.zshrc'
alias S='exec zsh'
alias IP='ifconfig | grep "inet "'
alias re='ssh -i "$HOME/Library/Mobile Documents/com~apple~CloudDocs/OracleSSH/oracle.key" ubuntu@server.mjstudio.net'

# GitHub
alias GIT='vim ~/.gitconfig'
alias CC='git add -A && git status && git commit --allow-empty -m "chore: unconscious commit 🎲"'
alias PUSH='CC && g ps'
alias csync='chezmoi re-add && chezmoi git -- add -A && (chezmoi git -- diff --cached --quiet || chezmoi git -- commit -m "chore: sync dotfiles") && chezmoi git -- pull --rebase && chezmoi git -- push && chezmoi apply'
alias GH="git config --get remote.origin.url | sed 's/git@github.com:/https:\/\/github.com\//' | sed 's/.git$//' | xargs open"
alias PR='gh pr view -w'
alias f=lazygit

# Kill a process listening on a port.
kp() {
  if [ -z "$1" ]; then
    echo "usage: kp <port>"
    return 1
  fi

  local pids
  pids=$(lsof -ti tcp:"$1")

  if [ -z "$pids" ]; then
    echo "no process on port $1"
    return 0
  fi

  echo "$pids" | xargs kill
  echo "killed port $1: $pids"
}

alias XCODE='cd ~/Library/Developer/Xcode'

ZSH_AUTOSUGGEST_STRATEGY=(history completion)

eval "$(mise activate zsh)"

alias -g -- -h='-h 2>&1 | bat --language=help --style=plain'
alias -g -- --help='--help 2>&1 | bat --language=help --style=plain'
